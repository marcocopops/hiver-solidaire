# Modèle des secrets des sauvegardes (deploy/backup.sh, deploy/restore.sh, ADR-0016). Valeurs FACTICES.
# Sur le serveur : copier vers /opt/hiver-solidaire/backup.env, chmod 600, propriétaire root. Jamais dans le dépôt.
# Ce fichier n'est lu que par le conteneur restic (compose.prod.yaml, service « restic ») : ni l'appli ni la base ne
# le voient.

# Dépôt restic dans le bucket R2 (juridiction UE : « .eu. » dans l'adresse). <ID_DU_COMPTE> : tableau de bord
# Cloudflare → R2 → « Account ID ».
RESTIC_REPOSITORY=s3:https://0000000000000000000000000000000.eu.r2.cloudflarestorage.com/hiver-solidaire-sauvegardes

# Mot de passe de chiffrement du dépôt : openssl rand -base64 32.
# À GARDER AUSSI HORS DU SERVEUR (gestionnaire de mots de passe) : sans lui, les sauvegardes sont illisibles.
RESTIC_PASSWORD=change-me-not-a-real-password

# Jeton d'API R2 « Object Read & Write » limité au seul bucket des sauvegardes.
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_DEFAULT_REGION=auto
