# Modèle de configuration locale. Copier vers .env (non versionné) et adapter.
# Toutes les valeurs ci-dessous sont factices.
POSTGRES_DB=hiver
POSTGRES_USER=hiver
POSTGRES_PASSWORD=change-me-dev-only

# Utilisés par l'application (./mvnw spring-boot:run)
DB_URL=jdbc:postgresql://localhost:5432/hiver
DB_USER=hiver
DB_PASSWORD=change-me-dev-only
