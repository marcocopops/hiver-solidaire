# Modèle de configuration locale. Copier vers .env (non versionné) et adapter.
# Toutes les valeurs ci-dessous sont factices.
POSTGRES_DB=hiver
POSTGRES_USER=hiver
POSTGRES_PASSWORD=change-me-dev-only

# Port de PostgreSQL de développement sur l'hôte (compose.yaml). Garder DB_URL cohérent.
DEV_DB_PORT=5433

# Utilisés par l'application (./mvnw spring-boot:run)
DB_URL=jdbc:postgresql://localhost:5433/hiver
DB_USER=hiver
DB_PASSWORD=change-me-dev-only

# Port de l'application en local (8080 par défaut). À décommenter si 8080 est déjà pris.
# SERVER_PORT=8090

# Origine publique de l'appli, pour construire le lien magique (jamais déduite de l'en-tête Host).
APP_BASE_URL=http://localhost:8080

# Envoi du lien de connexion et des e-mails automatiques (confirmations, rappel, alertes, récap). En local : Mailpit
# (compose.yaml), interface sur http://127.0.0.1:8025. Sans MAIL_HOST, l'appli démarre mais la connexion affiche
# « momentanément indisponible ». Avec MAIL_HOST, MAIL_FROM est obligatoire.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=hiver-solidaire@example.org
# Pour un vrai serveur SMTP (valeurs factices) :
# MAIL_USERNAME=utilisateur-smtp
# MAIL_PASSWORD=change-me
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true

# Développement seulement : laisse partir les e-mails vers les domaines réservés aux tests (example.org, .test,
# .invalid…), pour que Mailpit reçoive les adresses factices. En production, l'appli n'y envoie jamais rien.
APP_MAIL_ALLOW_RESERVED_DOMAINS=true

# Cloudflare Turnstile sur la demande de lien (ADR-0013). Clés de test publiées par Cloudflare : le widget passe
# toujours. Pour voir un refus, remplacer la clé secrète par 2x0000000000000000000000000000000AA. Ces clés ne sont
# acceptées qu'avec une APP_BASE_URL locale : en production, créer un widget (deploy/README.md).
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Adresses des coordinateurs, séparées par des virgules (ADR-0010) : rôle coordinateur et accès au back-office
# (/admin) à la connexion par lien magique. Adresses factices : en local, se connecter avec l'une d'elles (le lien
# arrive dans Mailpit). Vide : back-office fermé à tous.
APP_COORDINATOR_EMAILS=coordinatrice@example.org,coordinateur@example.org

# Ports de Mailpit sur l'hôte (compose.yaml), si 1025 ou 8025 sont déjà pris. Garder MAIL_PORT cohérent.
# DEV_SMTP_PORT=1025
# DEV_MAILPIT_UI_PORT=8025

# Développement seulement : décale l'horloge de l'appli (durée ISO 8601), pour essayer l'inscription avant
# l'ouverture du 14 décembre. Exemple : P70D. Ne jamais définir en production.
# APP_CLOCK_OFFSET=P70D

# Développement seulement : délai de regroupement des confirmations (10 minutes par défaut), raccourci pour les voir
# vite dans Mailpit. Ne jamais définir en production.
# APP_MAIL_CONFIRMATION_DELAY=PT30S

# Développement seulement : au démarrage, crée et envoie tout de suite le rappel de demain et le récap du jour (sans
# attendre 18 h ni 20 h). Une seule fois par jour et par bénévole : relancer scripts/seed-dev.sh --reset pour les
# recevoir de nouveau. Ne jamais définir en production.
# APP_MAIL_DEV_RUN_NOW=true
